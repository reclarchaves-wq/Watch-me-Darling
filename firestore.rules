rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        (request.auth.token.phone_number is string && request.auth.token.phone_number.size() >= 7)
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidUserAccount(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'contactMethod',
          'verified',
          'ageVerified18Plus',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'contactMethod',
          'verified',
          'ageVerified18Plus',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 48
        && data.contactMethod in ['email', 'mobile', 'google']
        && data.verified == true
        && data.ageVerified18Plus == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateContact(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'phoneNumber',
          'verifiedMethod',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'phoneNumber',
          'verifiedMethod',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 160
        && data.phoneNumber is string
        && data.phoneNumber.size() <= 32
        && data.verifiedMethod in ['email', 'mobile', 'google']
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isVerifiedUser() && resource.data.uid == request.auth.uid;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().contactMethod == existing().contactMethod
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'updatedAt'
        ]);

      allow delete: if false;

      match /private/{docId} {
        allow get: if isValidId(userId) && docId == 'contact' && isOwner(userId);
        allow list: if false;

        allow create: if isValidId(userId)
          && docId == 'contact'
          && isOwner(userId)
          && isValidPrivateContact(incoming())
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId)
          && docId == 'contact'
          && isOwner(userId)
          && isValidPrivateContact(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email',
            'phoneNumber',
            'verifiedMethod',
            'updatedAt'
          ]);

        allow delete: if false;
      }
    }
  }
}
